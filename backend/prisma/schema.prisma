generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  DEV
  GERENTE
  COORDINADOR
  AUDITOR
  MECANICO
}

enum FleetOperationalStatus {
  OPERATIONAL
  MAINTENANCE
  OUT_OF_SERVICE
}

enum FleetUnitType {
  CHASSIS
  CHASSIS_WITH_HYDROCRANE
  TRACTOR
  TRACTOR_WITH_HYDROCRANE
  SEMI_TRAILER
  AUTOMOBILE
  VAN
  PICKUP
}

enum AuditResult {
  APPROVED
  REJECTED
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  CLOSED
}

enum VisualStatus {
  OVERDUE
  OK
  DUE_SOON
}

enum FleetMovementType {
  ENTRY
  RETURN
}

enum FleetLogisticsStatus {
  AVAILABLE
  PENDING_DELIVERY
  DELIVERED
  PENDING_RETURN
  RETURNED
}

enum DeliveryOperationType {
  DELIVERY
  RETURN
}

enum TaskStatus {
  UNASSIGNED
  ASSIGNED
  IN_PROGRESS
  BLOCKED
  DONE
  CANCELED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum CurrencyCode {
  ARS
  USD
}

enum TaskEventType {
  CREATED
  UPDATED
  ASSIGNED
  UNASSIGNED
  MOVED_TO_BANK
  REMOVED_FROM_BANK
  TAKEN_FROM_BANK
  STATUS_CHANGED
  COMMENT
  VIEWED
}

enum CrmDealStage {
  LEAD
  CONTACTED
  QUALIFICATION
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum CrmDealKind {
  TENDER
  CONTRACT
}

enum CrmActivityType {
  CALL
  WHATSAPP
  EMAIL
  MEETING
  TASK
}

enum CrmActivityStatus {
  PENDING
  DONE
}

enum CrmDealUnitStatus {
  EN_CONCURSO
  ADJUDICADA
  PERDIDA
  LIBERADA
}

model User {
  id                  String   @id @default(uuid())
  username            String   @unique
  fullName            String
  role                UserRole
  passwordHash        String
  avatarUrl           String   @default("")
  permissions         Json?
  permissionOverrides Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  audits              AuditRecord[]
  tasksCreated        Task[]      @relation("TaskCreatedBy")
  tasksAssigned       Task[]      @relation("TaskAssignedTo")
  tasksAssignedBy     Task[]      @relation("TaskAssignedBy")
  tasksViewed         Task[]      @relation("TaskViewedBy")
  serviceOrdersCreated   ServiceOrder[] @relation("ServiceOrderCreatedBy")
  serviceOrdersAssigned  ServiceOrder[] @relation("ServiceOrderAssignedTo")
  taskEvents          TaskEvent[] @relation("TaskEventActor")
  deliveryOperationsRequested DeliveryOperation[] @relation("DeliveryRequestedBy")
  crmDealsCreated     CrmDeal[]      @relation("CrmDealCreatedBy")
  crmDealsAssigned    CrmDeal[]      @relation("CrmDealAssignedTo")
  crmActivitiesCreated CrmActivity[] @relation("CrmActivityCreatedBy")
  crmDealUnitsCreated CrmDealUnit[]  @relation("CrmDealUnitCreatedBy")
  fleetProjectsCreated      FleetProject[]     @relation("FleetProjectCreatedBy")
  fleetProjectItemsAssigned FleetProjectItem[] @relation("FleetProjectItemAssignedTo")
  postventaEventsCreated    PostventaEvent[]   @relation("PostventaEventCreatedBy")
  pushSubscriptions         PushSubscription[]
  invoicesCreated           Invoice[]          @relation("InvoiceCreatedBy")
  rentalContractsCreated    RentalContract[]   @relation("RentalContractCreatedBy")
  handoverChecklistsCreated HandoverChecklist[] @relation("HandoverChecklistCreatedBy")
  tiresCreated              Tire[]              @relation("TireCreatedBy")
  tripsAsDriver             Trip[]              @relation("TripDriver")
  tripsCreated              Trip[]              @relation("TripCreatedBy")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String   @default("")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model FleetUnit {
  id                       String   @id @default(uuid())
  qrId                     String   @unique
  internalCode             String   @unique
  brand                    String
  model                    String
  year                     Int      @default(0)
  clientId                 String?
  clientName               String   @default("")
  location                 String   @default("")
  ownerCompany             String
  operationalStatus        FleetOperationalStatus
  logisticsStatus          FleetLogisticsStatus @default(AVAILABLE)
  logisticsStatusNote      String   @default("")
  logisticsUpdatedAt       DateTime?
  unitType                 FleetUnitType
  configurationNotes       String
  chassisNumber            String
  engineNumber             String
  tareWeightKg             Int
  maxLoadKg                Int
  hasHydroCrane            Boolean
  hydroCraneBrand          String
  hydroCraneModel          String
  hydroCraneSerialNumber   String
  hasSemiTrailer           Boolean
  semiTrailerUnitId        String?
  semiTrailerLicensePlate  String
  semiTrailerBrand         String
  semiTrailerModel         String
  semiTrailerYear          Int
  semiTrailerChassisNumber String
  tractorHistoryIds        Json
  currentKilometers        Int      @default(0)
  currentEngineHours       Int      @default(0)
  currentHydroHours        Int      @default(0)
  engineCylinders          Int?
  profilePhotoUrl          String?
  lubricants               Json
  filters                  Json
  documents                Json
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  semiTrailer              FleetUnit?  @relation("SemiTrailer", fields: [semiTrailerUnitId], references: [id])
  tractors                 FleetUnit[] @relation("SemiTrailer")
  client                   ClientAccount? @relation(fields: [clientId], references: [id])

  maintenancePlans         MaintenancePlan[]
  audits                   AuditRecord[]
  workOrders               WorkOrder[]
  repairs                  RepairRecord[]
  externalRequests         ExternalRequest[]
  movementLinks            FleetMovementUnit[]
  deliveryOperations       DeliveryOperation[]
  crmDealLinks             CrmDealUnit[]
  fleetProjects            FleetProject[]
  postventaEvents          PostventaEvent[]
  serviceOrders            ServiceOrder[]
  telemetryDevices         TelemetryDevice[]
  invoices                 Invoice[]
  rentalContracts          RentalContract[]
  handoverChecklists       HandoverChecklist[]
  tires                    Tire[]
  tasks                    Task[]              @relation("TaskUnit")
  trips                    Trip[]              @relation("TripUnit")

  @@index([clientId])
  @@index([logisticsStatus])
}

model PostventaEvent {
  id              String    @id @default(uuid())
  title           String
  startDate       DateTime
  endDate         DateTime?
  notes           String    @default("")
  unitId          String?
  externalVehicle String?
  workOrderId     String?
  color           String    @default("amber")
  createdByUserId String
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  unit      FleetUnit? @relation(fields: [unitId], references: [id])
  createdBy User       @relation("PostventaEventCreatedBy", fields: [createdByUserId], references: [id])

  @@index([startDate])
  @@index([unitId])
}

model MaintenancePlan {
  id                        String   @id @default(uuid())
  unitId                    String
  maintenanceType           String   @default("MOTOR")
  currentKilometers         Int
  currentHours              Int
  serviceIntervalKilometers Int?
  serviceIntervalHours      Int?
  nextServiceByKilometers   Int
  nextServiceByHours        Int
  oils                      Json
  filters                   Json
  notes                     String
  status                    VisualStatus
  serviceSchedule           Json
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt

  unit FleetUnit @relation(fields: [unitId], references: [id])
}

model AuditRecord {
  id              String   @id @default(uuid())
  code            String   @unique
  auditKind       String   @default("AUDIT")
  unitId          String?
  externalVehicle String?
  auditorUserId   String
  auditorName    String
  workOrderId    String?
  performedAt    DateTime
  result         AuditResult
  observations   String
  photoUrls      Json
  checklist      Json
  unitKilometers Int      @default(0)
  engineHours    Int      @default(0)
  hydroHours     Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  unit    FleetUnit? @relation(fields: [unitId], references: [id])
  auditor User       @relation(fields: [auditorUserId], references: [id])
}

model WorkOrder {
  id                     String   @id @default(uuid())
  code                   String   @unique
  pendingReaudit         Boolean  @default(false)
  unitId                 String?
  externalVehicle        String?
  status                 WorkOrderStatus
  taskList               Json
  spareParts             Json
  laborDetail            String
  linkedInventorySkuList Json
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  unit FleetUnit? @relation(fields: [unitId], references: [id])
}

model RepairRecord {
  id               String   @id @default(uuid())
  unitId           String
  workOrderId      String?
  externalRequestId String? 
  sourceType       String   @default("WORK_ORDER")
  supplierId       String?
  performedAt      DateTime @default(now())
  unitKilometers   Int      @default(0)
  currency         CurrencyCode @default(ARS)
  supplierName     String
  linkedExternalRequestIds Json   @default("[]")
  laborCost         Float   @default(0)
  partsCost         Float   @default(0)
  partsUsed         Json    @default("[]")
  realCost         Float
  invoicedToClient Float
  margin           Float
  invoiceFileName  String   @default("")
  invoiceFileBase64 String  @default("")
  invoiceFileUrl   String   @default("")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  unit FleetUnit @relation(fields: [unitId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])
  externalRequestsLinked ExternalRequest[] @relation("ExternalRequestsLinkedToRepair")
  invoices Invoice[]
}

model Invoice {
  id               String    @id @default(uuid())
  code             String    @unique
  providerName     String
  supplierId       String?
  invoiceNumber    String    @default("")
  amount           Float     @default(0)
  currency         String    @default("ARS")
  issuedAt         DateTime?
  notes            String    @default("")
  fileName         String    @default("")
  fileBase64       String    @default("")
  fileUrl          String    @default("")
  repairId         String?
  unitId           String?
  inventoryItemIds Json      @default("[]")
  inventoryItemQuantities Json @default("{}")
  createdByUserId  String
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  repair    RepairRecord? @relation(fields: [repairId], references: [id])
  unit      FleetUnit?    @relation(fields: [unitId], references: [id])
  supplier  Supplier?     @relation(fields: [supplierId], references: [id])
  createdBy User          @relation("InvoiceCreatedBy", fields: [createdByUserId], references: [id])

  @@index([repairId])
  @@index([unitId])
  @@index([supplierId])
}

model InventoryItem {
  id                 String   @id @default(uuid())
  sku                String   @unique
  externalBarcode    String?
  productName        String
  description        String   @default("")
  stock              Float
  unit               String   @default("UNIDAD")
  unitPrice          Float?
  currency           String   @default("ARS")
  movementHistory    Json
  linkedWorkOrderIds Json
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ExternalRequest {
  id          String   @id @default(uuid())
  code        String   @unique
  unitId      String
  companyName String
  description String
  tasks       Json
  currency    String   @default("ARS")
  partsItems  Json     @default("[]")
  partsTotal  Float    @default(0)
  eligibilityStatus String @default("PENDING_ATTACHMENT")
  linkedRepairId String?
  serviceOrderId String?
  providerFileName String   @default("")
  providerFileUrl  String   @default("")
  ocCode           String?
  ocGeneratedAt    DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  unit FleetUnit @relation(fields: [unitId], references: [id])
  linkedRepair RepairRecord? @relation("ExternalRequestsLinkedToRepair", fields: [linkedRepairId], references: [id])
  serviceOrder ServiceOrder? @relation(fields: [serviceOrderId], references: [id])

  @@index([linkedRepairId])
  @@index([serviceOrderId])
}

model FleetMovement {
  id                   String            @id @default(uuid())
  movementType         FleetMovementType
  remitoNumber         String            @default("")
  remitoDate           DateTime?
  clientId             String?
  clientName           String            @default("")
  workLocation         String            @default("")
  equipmentDescription String            @default("")
  observations         String            @default("")
  deliveryContactName  String            @default("")
  deliveryContactDni   String            @default("")
  deliveryContactSector String           @default("")
  deliveryContactRole  String            @default("")
  receiverContactName  String            @default("")
  receiverContactDni   String            @default("")
  receiverContactSector String           @default("")
  receiverContactRole  String            @default("")
  pdfFileName          String            @default("")
  pdfFileUrl           String            @default("")
  parsedPayload        Json?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  client ClientAccount? @relation(fields: [clientId], references: [id])
  units  FleetMovementUnit[]

  @@index([clientId])
}

model FleetMovementUnit {
  movementId String
  unitId     String

  movement FleetMovement @relation(fields: [movementId], references: [id])
  unit     FleetUnit     @relation(fields: [unitId], references: [id])

  @@id([movementId, unitId])
}

model Task {
  id               String       @id @default(uuid())
  title            String       @default("")
  description      String
  status           TaskStatus   @default(UNASSIGNED)
  priority         TaskPriority @default(MEDIUM)
  type             String       @default("OTRA")
  unitId           String?
  assignedToUserId String?
  assignedToExternalName String @default("")
  assignedByUserId String?
  createdByUserId  String
  isInTaskBank     Boolean      @default(false)
  startDate        DateTime?
  estimatedFinishDate DateTime?
  closedAt         DateTime?
  viewedAt         DateTime?
  viewedByUserId   String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  assignedTo User?      @relation("TaskAssignedTo", fields: [assignedToUserId], references: [id])
  assignedBy User?      @relation("TaskAssignedBy", fields: [assignedByUserId], references: [id])
  createdBy  User       @relation("TaskCreatedBy", fields: [createdByUserId], references: [id])
  viewedBy   User?      @relation("TaskViewedBy", fields: [viewedByUserId], references: [id])
  unit       FleetUnit? @relation("TaskUnit", fields: [unitId], references: [id])
  events     TaskEvent[]

  @@index([status])
  @@index([priority])
  @@index([assignedToUserId])
  @@index([isInTaskBank])
  @@index([unitId])
}

model TaskEvent {
  id                   String        @id @default(uuid())
  taskId               String
  type                 TaskEventType
  actorUserId          String
  notes                String        @default("")
  fromStatus           TaskStatus?
  toStatus             TaskStatus?
  fromAssignedToUserId String?
  toAssignedToUserId   String?
  createdAt            DateTime      @default(now())

  task   Task @relation(fields: [taskId], references: [id])
  actor  User @relation("TaskEventActor", fields: [actorUserId], references: [id])

  @@index([taskId, createdAt])
  @@index([actorUserId])
}

model Sequence {
  key   String @id
  value Int
}

model AppSettings {
  id                 String   @id @default("app")
  maintenanceEnabled Boolean  @default(false)
  maintenanceMessage String   @default("")
  featureFlags       Json     @default("{}")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model ClientAccount {
  id            String   @id @default(uuid())
  name          String   @unique
  legalName     String   @default("")
  taxId         String   @default("")
  contactName   String   @default("")
  contactPhone  String   @default("")
  contactEmail  String   @default("")
  notes         String   @default("")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  units             FleetUnit[]
  deliveries        DeliveryOperation[]
  crmDeals          CrmDeal[]
  serviceOrders     ServiceOrder[]
  movements         FleetMovement[]
  rentalContracts   RentalContract[]
  handoverChecklists HandoverChecklist[]
}

model RentalContract {
  id                     String    @id @default(uuid())
  code                   String    @default("")
  unitId                 String
  clientId               String?
  clientName             String    @default("")
  startDate              DateTime
  endDate                DateTime
  monthlyValue           Float     @default(0)
  currency               CurrencyCode @default(ARS)
  status                 String    @default("ACTIVE")
  notes                  String    @default("")
  expirationAlertSentAt  DateTime?
  createdByUserId        String
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  unit      FleetUnit      @relation(fields: [unitId], references: [id])
  client    ClientAccount? @relation(fields: [clientId], references: [id])
  createdBy User           @relation("RentalContractCreatedBy", fields: [createdByUserId], references: [id])
  handoverChecklists HandoverChecklist[]

  @@index([unitId])
  @@index([clientId])
  @@index([endDate])
}

model HandoverChecklist {
  id                String   @id @default(uuid())
  code              String   @default("")
  type              String
  unitId            String
  clientId          String?
  clientName        String   @default("")
  contractId        String?
  responsibleName   String   @default("")
  performedAt       DateTime
  unitKilometers    Int      @default(0)
  engineHours       Int      @default(0)
  fuelLevelPct      Int      @default(0)
  checklist         Json     @default("{}")
  damagesFound      String   @default("")
  chargeToClientUsd Float    @default(0)
  photoUrls         Json     @default("[]")
  signedActUrl      String   @default("")
  observations      String   @default("")
  createdByUserId   String
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  unit      FleetUnit       @relation(fields: [unitId], references: [id])
  client    ClientAccount?  @relation(fields: [clientId], references: [id])
  contract  RentalContract? @relation(fields: [contractId], references: [id])
  createdBy User            @relation("HandoverChecklistCreatedBy", fields: [createdByUserId], references: [id])

  @@index([unitId])
  @@index([clientId])
  @@index([type, performedAt])
}

model Tire {
  id                String    @id @default(uuid())
  unitId            String
  position          String
  brand             String    @default("")
  model             String    @default("")
  installedAt       DateTime?
  installedKm       Int       @default(0)
  lastRotationKm    Int?
  costBase          Float     @default(0)
  currency          String    @default("ARS")
  notes             String    @default("")
  isActive          Boolean   @default(true)
  removedAt         DateTime?
  wearAlertSentAt   DateTime?
  createdByUserId   String
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  unit      FleetUnit @relation(fields: [unitId], references: [id])
  createdBy User      @relation("TireCreatedBy", fields: [createdByUserId], references: [id])

  @@index([unitId])
  @@index([isActive])
}

model Trip {
  id                 String   @id @default(uuid())
  code               String   @default("")
  driverUserId       String?
  driverExternalName String   @default("")
  unitId             String?
  startDate          DateTime
  endDate            DateTime
  originLabel        String   @default("")
  originLat          Float
  originLng          Float
  destinationLabel   String   @default("")
  destinationLat     Float
  destinationLng     Float
  distanceKm         Float    @default(0)
  distanceSource     String   @default("ROUTE")
  notes              String   @default("")
  createdByUserId    String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  driver    User?      @relation("TripDriver", fields: [driverUserId], references: [id])
  unit      FleetUnit? @relation("TripUnit", fields: [unitId], references: [id])
  createdBy User       @relation("TripCreatedBy", fields: [createdByUserId], references: [id])

  @@index([driverUserId])
  @@index([unitId])
  @@index([startDate])
}

model Supplier {
  id            String   @id @default(uuid())
  name          String   @unique
  serviceType   String   @default("")
  paymentMethod String   @default("")
  paymentTerms  String   @default("")
  address       String   @default("")
  mapsUrl       String   @default("")
  contactName   String   @default("")
  contactPhone  String   @default("")
  contactEmail  String   @default("")
  notes         String   @default("")
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  repairs       RepairRecord[]
  invoices      Invoice[]
}

model DeliveryOperation {
  id                   String                @id @default(uuid())
  unitId               String
  clientId             String?
  operationType        DeliveryOperationType
  targetLogisticsStatus FleetLogisticsStatus
  summary              String                @default("")
  reason               String                @default("")
  remitoFileName       String                @default("")
  remitoFileUrl        String                @default("")
  remitoAttachedAt     DateTime?
  remitoAttachedByUserName String            @default("")
  requestedByUserId    String?
  requestedByUserName  String                @default("")
  effectiveAt          DateTime              @default(now())
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  unit                 FleetUnit             @relation(fields: [unitId], references: [id])
  client               ClientAccount?        @relation(fields: [clientId], references: [id])
  requestedByUser      User?                 @relation("DeliveryRequestedBy", fields: [requestedByUserId], references: [id])

  @@index([unitId, createdAt])
  @@index([clientId, createdAt])
  @@index([operationType, createdAt])
}

model CrmDeal {
  id                 String          @id @default(uuid())
  title              String
  companyName        String
  dealKind           CrmDealKind     @default(TENDER)
  referenceCode      String          @default("")
  isHistorical       Boolean         @default(false)
  contactName        String          @default("")
  contactEmail       String          @default("")
  contactPhone       String          @default("")
  source             String          @default("")
  serviceLine        String          @default("")
  amount             Float           @default(0)
  currency           CurrencyCode    @default(ARS)
  probability        Int             @default(10)
  stage              CrmDealStage    @default(LEAD)
  expectedCloseDate  DateTime?
  lastContactAt      DateTime?
  lostReason         String          @default("")
  notes              String          @default("")
  assignedToUserId   String?
  convertedClientId  String?
  createdByUserId    String
  wonAt              DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  assignedToUser     User?           @relation("CrmDealAssignedTo", fields: [assignedToUserId], references: [id])
  createdByUser      User            @relation("CrmDealCreatedBy", fields: [createdByUserId], references: [id])
  convertedClient    ClientAccount?  @relation(fields: [convertedClientId], references: [id])
  activities         CrmActivity[]
  unitLinks          CrmDealUnit[]

  @@index([stage, createdAt])
  @@index([assignedToUserId, stage])
  @@index([convertedClientId])
  @@index([companyName])
  @@index([dealKind, stage])
}

model CrmActivity {
  id              String            @id @default(uuid())
  dealId          String
  type            CrmActivityType
  status          CrmActivityStatus @default(PENDING)
  summary         String
  dueAt           DateTime?
  completedAt     DateTime?
  createdByUserId String
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  deal            CrmDeal           @relation(fields: [dealId], references: [id])
  createdByUser   User              @relation("CrmActivityCreatedBy", fields: [createdByUserId], references: [id])

  @@index([dealId, status, dueAt])
  @@index([createdByUserId, createdAt])
}

model CrmDealUnit {
  id              String            @id @default(uuid())
  dealId          String
  unitId          String
  status          CrmDealUnitStatus @default(EN_CONCURSO)
  notes           String            @default("")
  createdByUserId String
  linkedAt        DateTime          @default(now())
  releasedAt      DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  deal            CrmDeal           @relation(fields: [dealId], references: [id], onDelete: Cascade)
  unit            FleetUnit         @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdByUser   User              @relation("CrmDealUnitCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@unique([dealId, unitId])
  @@index([dealId, status])
  @@index([unitId, status])
}

model FleetProject {
  id                String             @id @default(uuid())
  title             String
  projectTypes      Json               @default("[]")
  status            String             @default("PENDING")
  priority          TaskPriority       @default(MEDIUM)
  unitId            String
  description       String             @default("")
  estimatedCost     Float              @default(0)
  actualCost        Float              @default(0)
  currency          String             @default("ARS")
  createdByUserId   String
  targetDate        DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  externalRequestId        String?
  modificationNotes        String             @default("")
  linkedWorkOrderIds       Json               @default("[]")
  linkedExternalRequestIds Json               @default("[]")
  createdAt                DateTime           @default(now())
  updatedAt                DateTime           @updatedAt

  unit       FleetUnit          @relation(fields: [unitId], references: [id])
  createdBy  User               @relation("FleetProjectCreatedBy", fields: [createdByUserId], references: [id])
  items      FleetProjectItem[]

  @@index([status])
  @@index([unitId])
}

model FleetProjectItem {
  id               String                 @id @default(uuid())
  projectId        String
  title            String
  description      String                 @default("")
  status           String                 @default("PENDING")
  assignedToUserId String?
  completedAt      DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  project    FleetProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo User?        @relation("FleetProjectItemAssignedTo", fields: [assignedToUserId], references: [id])

  @@index([projectId])
}

model ServiceOrder {
  id                    String             @id @default(uuid())
  code                  String             @unique
  unitId                String?
  externalVehicle       String?
  clientId              String?
  clientName            String             @default("")
  reportedFault         String
  claimOrigin           String             @default("EMAIL")
  status                String             @default("OPEN")
  estimatedResolutionAt DateTime?
  closedAt              DateTime?
  resolutionDetail      String             @default("")
  assignedToUserId      String?
  assignedToName        String             @default("")
  sparePartsUsed        String             @default("")
  photoUrls             Json               @default("[]")
  createdByUserId       String
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  unit        FleetUnit?     @relation(fields: [unitId], references: [id])
  client      ClientAccount? @relation(fields: [clientId], references: [id])
  assignedTo  User?          @relation("ServiceOrderAssignedTo", fields: [assignedToUserId], references: [id])
  createdBy   User           @relation("ServiceOrderCreatedBy", fields: [createdByUserId], references: [id])
  externalRequests ExternalRequest[]

  @@index([unitId, createdAt])
  @@index([status, createdAt])
  @@index([clientId])
  @@index([assignedToUserId])
}

// Ingesta de GPS/telemetria de proveedores externos (RSV, Microtrack, etc.)
// via webhook. Un "device" = un equipo GPS del proveedor, identificado por
// deviceExternalId+provider, opcionalmente vinculado a una unidad de flota
// por patente/codigo interno. Cada posicion se guarda como registro
// historico (nunca se pisa) para poder reconstruir el recorrido despues.
model TelemetryDevice {
  id               String    @id @default(uuid())
  deviceExternalId String
  provider         String
  imei             String?
  unitId           String?
  lastSeenAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  unit      FleetUnit?          @relation(fields: [unitId], references: [id])
  positions TelemetryPosition[]

  @@unique([deviceExternalId, provider])
  @@index([unitId])
}

model TelemetryPosition {
  id           String   @id @default(uuid())
  deviceId     String
  capturedAt   DateTime
  receivedAt   DateTime @default(now())
  latitude     Float
  longitude    Float
  speedKph     Float?
  heading      Float?
  altitudeM    Float?
  accuracyM    Float?
  odometerKm   Float?
  fuelLevelPct Float?
  engineOn     Boolean?
  dtcCodes     Json?
  rawPayload   Json?

  device TelemetryDevice @relation(fields: [deviceId], references: [id])

  @@index([deviceId, capturedAt])
  @@index([capturedAt])
}
